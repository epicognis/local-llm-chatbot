# Copy to `.env` and adjust. NEVER commit `.env`.
# Loaded by pydantic-settings (config/settings.py) at startup; values here
# OVERRIDE the code defaults. The `app_started` log line shows what resolved.

# Backend: ollama | mock   (mock = deterministic replies, no GPU / no network)
LLM_BACKEND=ollama

# Friendly name from llm/registry.py, used when /chat omits "model"
DEFAULT_MODEL=Gemma 4 12B

# Ollama daemon
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_KEEP_ALIVE=30m            # how long a model stays loaded after a turn

# Generation defaults — seed values for the UI's LLM Config panel; each turn
# may override them. top_p / top_k mirror Ollama's own defaults.
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=1024
DEFAULT_TOP_P=0.9
DEFAULT_TOP_K=40
CONTEXT_SAFETY_MARGIN=768

# Context management: 0 = raw passthrough (refuses on overflow),
# 1 = sliding window, 2 = recursive summarization (default)
CONTEXT_LEVEL=2

# Level 2 — recursive summarization
SUMMARY_KEEP_RECENT_TURNS=4      # verbatim recency window
SUMMARY_TARGET_BUDGET_TOKENS=0   # ceiling for the history block; 0 = whatever the window allows
SUMMARY_INPUT_BUDGET_TOKENS=6000 # max tokens fed to one summarize call
SUMMARY_RECOMPACT_CADENCE=20     # full recompaction every N incremental folds (0 = never)

# System persona prepended to every conversation
# SYSTEM_PROMPT=You are a helpful assistant.

# Session storage (SQLite path or sqlite:/// URL)
SESSION_DB_URL=sqlite:///./sessions.db
